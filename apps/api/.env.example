PORT=4000
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<publishable or anon key>
# Optional: only needed for POST /api/v1/admin/users (creating staff accounts)
SUPABASE_SERVICE_ROLE_KEY=
# Extra allowed front-end origins, comma separated (transguard*.vercel.app and localhost are allowed by default)
CORS_ORIGINS=
VERIFY_DEADLINE_MINUTES=10
